{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-Signal Category Scan",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "category_taxonomy",
        "query_set",
        "demand_signals",
        "seller_listing_census",
        "review_mining",
        "fee_logistics",
        "price_rank_snapshots",
        "gaps",
        "validation_test"
      ],
      "properties": {
        "category_taxonomy": {
          "type": "string",
          "minLength": 3
        },
        "query_set": {
          "type": "string",
          "minLength": 3
        },
        "demand_signals": {
          "type": "string",
          "minLength": 3
        },
        "seller_listing_census": {
          "type": "string",
          "minLength": 3
        },
        "review_mining": {
          "type": "string",
          "minLength": 3
        },
        "fee_logistics": {
          "type": "string",
          "minLength": 3
        },
        "price_rank_snapshots": {
          "type": "string",
          "minLength": 3
        },
        "gaps": {
          "type": "string",
          "minLength": 3
        },
        "validation_test": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
