{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question-to-Evidence Protocol",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "decision_question",
        "constructs_hypotheses",
        "desk_research",
        "qualitative_quantitative_design",
        "sample_frame",
        "instrument_pilot",
        "fieldwork_qa",
        "analysis",
        "limitations",
        "recommendation"
      ],
      "properties": {
        "decision_question": {
          "type": "string",
          "minLength": 3
        },
        "constructs_hypotheses": {
          "type": "string",
          "minLength": 3
        },
        "desk_research": {
          "type": "string",
          "minLength": 3
        },
        "qualitative_quantitative_design": {
          "type": "string",
          "minLength": 3
        },
        "sample_frame": {
          "type": "string",
          "minLength": 3
        },
        "instrument_pilot": {
          "type": "string",
          "minLength": 3
        },
        "fieldwork_qa": {
          "type": "string",
          "minLength": 3
        },
        "analysis": {
          "type": "string",
          "minLength": 3
        },
        "limitations": {
          "type": "string",
          "minLength": 3
        },
        "recommendation": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
