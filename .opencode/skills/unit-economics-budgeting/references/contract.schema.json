{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit-Cohort-Driver Budget",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "define_unit_cohort_time",
        "revenue_bridge",
        "variable_step_fixed_costs",
        "contribution",
        "cac_retention_ltv_payback",
        "driver_based_budget",
        "base_downside_upside",
        "cash_runway_guardrails"
      ],
      "properties": {
        "define_unit_cohort_time": {
          "type": "string",
          "minLength": 3
        },
        "revenue_bridge": {
          "type": "string",
          "minLength": 3
        },
        "variable_step_fixed_costs": {
          "type": "string",
          "minLength": 3
        },
        "contribution": {
          "type": "string",
          "minLength": 3
        },
        "cac_retention_ltv_payback": {
          "type": "string",
          "minLength": 3
        },
        "driver_based_budget": {
          "type": "string",
          "minLength": 3
        },
        "base_downside_upside": {
          "type": "string",
          "minLength": 3
        },
        "cash_runway_guardrails": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
