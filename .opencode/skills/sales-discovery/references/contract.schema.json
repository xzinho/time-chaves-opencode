{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavior-to-Gap Conversation",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "account_hypothesis",
        "agenda_permission",
        "current_behavior",
        "problem_impact",
        "desired_state",
        "past_attempts",
        "stakeholders_process",
        "priority_timing",
        "summarize_confirm",
        "mutual_next_step"
      ],
      "properties": {
        "account_hypothesis": {
          "type": "string",
          "minLength": 3
        },
        "agenda_permission": {
          "type": "string",
          "minLength": 3
        },
        "current_behavior": {
          "type": "string",
          "minLength": 3
        },
        "problem_impact": {
          "type": "string",
          "minLength": 3
        },
        "desired_state": {
          "type": "string",
          "minLength": 3
        },
        "past_attempts": {
          "type": "string",
          "minLength": 3
        },
        "stakeholders_process": {
          "type": "string",
          "minLength": 3
        },
        "priority_timing": {
          "type": "string",
          "minLength": 3
        },
        "summarize_confirm": {
          "type": "string",
          "minLength": 3
        },
        "mutual_next_step": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
