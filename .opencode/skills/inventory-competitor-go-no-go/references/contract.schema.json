{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market-Inventory Gate",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "market_boundary",
        "substitutes_competitors",
        "demand_evidence",
        "supply_price_fees",
        "inventory_cash_cycle",
        "contribution_scenarios",
        "strategic_fit",
        "kill_criteria",
        "gate"
      ],
      "properties": {
        "market_boundary": {
          "type": "string",
          "minLength": 3
        },
        "substitutes_competitors": {
          "type": "string",
          "minLength": 3
        },
        "demand_evidence": {
          "type": "string",
          "minLength": 3
        },
        "supply_price_fees": {
          "type": "string",
          "minLength": 3
        },
        "inventory_cash_cycle": {
          "type": "string",
          "minLength": 3
        },
        "contribution_scenarios": {
          "type": "string",
          "minLength": 3
        },
        "strategic_fit": {
          "type": "string",
          "minLength": 3
        },
        "kill_criteria": {
          "type": "string",
          "minLength": 3
        },
        "gate": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
