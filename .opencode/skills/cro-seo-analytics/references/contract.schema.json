{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent-to-Experiment Chain",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "query_intent_clusters",
        "technical_indexability",
        "serp_promise",
        "landing_continuity",
        "event_qa",
        "funnel_cohort",
        "evidence_backed_hypothesis",
        "experiment_design",
        "readout"
      ],
      "properties": {
        "query_intent_clusters": {
          "type": "string",
          "minLength": 3
        },
        "technical_indexability": {
          "type": "string",
          "minLength": 3
        },
        "serp_promise": {
          "type": "string",
          "minLength": 3
        },
        "landing_continuity": {
          "type": "string",
          "minLength": 3
        },
        "event_qa": {
          "type": "string",
          "minLength": 3
        },
        "funnel_cohort": {
          "type": "string",
          "minLength": 3
        },
        "evidence_backed_hypothesis": {
          "type": "string",
          "minLength": 3
        },
        "experiment_design": {
          "type": "string",
          "minLength": 3
        },
        "readout": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
