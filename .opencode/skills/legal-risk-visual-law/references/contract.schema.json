{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meaning-Preserving Legal Design",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "legal_source",
        "rule_condition_exception_consequence_extraction",
        "audience_task",
        "layer_architecture",
        "visual_encoding",
        "legal_fidelity_review",
        "comprehension_test",
        "revision"
      ],
      "properties": {
        "legal_source": {
          "type": "string",
          "minLength": 3
        },
        "rule_condition_exception_consequence_extraction": {
          "type": "string",
          "minLength": 3
        },
        "audience_task": {
          "type": "string",
          "minLength": 3
        },
        "layer_architecture": {
          "type": "string",
          "minLength": 3
        },
        "visual_encoding": {
          "type": "string",
          "minLength": 3
        },
        "legal_fidelity_review": {
          "type": "string",
          "minLength": 3
        },
        "comprehension_test": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
