{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace-to-Narrative Observatory",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "decision_query_book",
        "platform_sample_plan",
        "collect_with_timestamps",
        "dedupe_entities",
        "code_themes_stance_format",
        "velocity_novelty",
        "corroborate",
        "narrative_map",
        "implications_caveats"
      ],
      "properties": {
        "decision_query_book": {
          "type": "string",
          "minLength": 3
        },
        "platform_sample_plan": {
          "type": "string",
          "minLength": 3
        },
        "collect_with_timestamps": {
          "type": "string",
          "minLength": 3
        },
        "dedupe_entities": {
          "type": "string",
          "minLength": 3
        },
        "code_themes_stance_format": {
          "type": "string",
          "minLength": 3
        },
        "velocity_novelty": {
          "type": "string",
          "minLength": 3
        },
        "corroborate": {
          "type": "string",
          "minLength": 3
        },
        "narrative_map": {
          "type": "string",
          "minLength": 3
        },
        "implications_caveats": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
