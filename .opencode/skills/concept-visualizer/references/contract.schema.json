{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relation-to-Form Compiler",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "frase_nuclear",
        "entidades_rela_es",
        "tipo_hierarquia_fluxo_ciclo_mapa_matriz_causalidade",
        "n_vel_de_abstra_o",
        "layout",
        "teste_de_leitura",
        "fonte_renderiz_vel"
      ],
      "properties": {
        "frase_nuclear": {
          "type": "string",
          "minLength": 3
        },
        "entidades_rela_es": {
          "type": "string",
          "minLength": 3
        },
        "tipo_hierarquia_fluxo_ciclo_mapa_matriz_causalidade": {
          "type": "string",
          "minLength": 3
        },
        "n_vel_de_abstra_o": {
          "type": "string",
          "minLength": 3
        },
        "layout": {
          "type": "string",
          "minLength": 3
        },
        "teste_de_leitura": {
          "type": "string",
          "minLength": 3
        },
        "fonte_renderiz_vel": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
