{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbook Lineage Audit",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "file_inventory",
        "sheet_range_map",
        "types_nulls_duplicates",
        "formula_lineage",
        "named_ranges_external_links",
        "reconciliation",
        "anomaly_tests",
        "preserve_edit",
        "parse_back_render_qa"
      ],
      "properties": {
        "file_inventory": {
          "type": "string",
          "minLength": 3
        },
        "sheet_range_map": {
          "type": "string",
          "minLength": 3
        },
        "types_nulls_duplicates": {
          "type": "string",
          "minLength": 3
        },
        "formula_lineage": {
          "type": "string",
          "minLength": 3
        },
        "named_ranges_external_links": {
          "type": "string",
          "minLength": 3
        },
        "reconciliation": {
          "type": "string",
          "minLength": 3
        },
        "anomaly_tests": {
          "type": "string",
          "minLength": 3
        },
        "preserve_edit": {
          "type": "string",
          "minLength": 3
        },
        "parse_back_render_qa": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
