{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-Calibrated Portfolio",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "define_outcome_unit",
        "normalize_ideas",
        "score_reach_impact_confidence_effort_strategic_fit_risk",
        "evidence_grade",
        "uncertainty_penalty",
        "rank",
        "portfolio_balance",
        "next_test"
      ],
      "properties": {
        "define_outcome_unit": {
          "type": "string",
          "minLength": 3
        },
        "normalize_ideas": {
          "type": "string",
          "minLength": 3
        },
        "score_reach_impact_confidence_effort_strategic_fit_risk": {
          "type": "string",
          "minLength": 3
        },
        "evidence_grade": {
          "type": "string",
          "minLength": 3
        },
        "uncertainty_penalty": {
          "type": "string",
          "minLength": 3
        },
        "rank": {
          "type": "string",
          "minLength": 3
        },
        "portfolio_balance": {
          "type": "string",
          "minLength": 3
        },
        "next_test": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
