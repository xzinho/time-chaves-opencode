{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision-First Brief",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "decision_statement",
        "one_line_answer",
        "material_facts",
        "options_tradeoffs",
        "recommendation",
        "risks_unknowns",
        "explicit_ask",
        "owners_dates"
      ],
      "properties": {
        "decision_statement": {
          "type": "string",
          "minLength": 3
        },
        "one_line_answer": {
          "type": "string",
          "minLength": 3
        },
        "material_facts": {
          "type": "string",
          "minLength": 3
        },
        "options_tradeoffs": {
          "type": "string",
          "minLength": 3
        },
        "recommendation": {
          "type": "string",
          "minLength": 3
        },
        "risks_unknowns": {
          "type": "string",
          "minLength": 3
        },
        "explicit_ask": {
          "type": "string",
          "minLength": 3
        },
        "owners_dates": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
