{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim-Beat-Retention Script",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "audience_awareness_offer",
        "core_promise",
        "claim_proof_inventory",
        "hook_variants",
        "problem_stakes",
        "mechanism",
        "proof_demo",
        "objections",
        "offer_cta",
        "beat_timecode",
        "visual_audio_directions",
        "read_time_claim_qa"
      ],
      "properties": {
        "audience_awareness_offer": {
          "type": "string",
          "minLength": 3
        },
        "core_promise": {
          "type": "string",
          "minLength": 3
        },
        "claim_proof_inventory": {
          "type": "string",
          "minLength": 3
        },
        "hook_variants": {
          "type": "string",
          "minLength": 3
        },
        "problem_stakes": {
          "type": "string",
          "minLength": 3
        },
        "mechanism": {
          "type": "string",
          "minLength": 3
        },
        "proof_demo": {
          "type": "string",
          "minLength": 3
        },
        "objections": {
          "type": "string",
          "minLength": 3
        },
        "offer_cta": {
          "type": "string",
          "minLength": 3
        },
        "beat_timecode": {
          "type": "string",
          "minLength": 3
        },
        "visual_audio_directions": {
          "type": "string",
          "minLength": 3
        },
        "read_time_claim_qa": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
