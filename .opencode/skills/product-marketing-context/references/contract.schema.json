{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Positioning Evidence File",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "customer_evidence",
        "job_circumstance",
        "alternatives",
        "unique_attributes",
        "value_proof",
        "best_fit_segment",
        "category_frame",
        "message_boundaries",
        "versioned_context"
      ],
      "properties": {
        "customer_evidence": {
          "type": "string",
          "minLength": 3
        },
        "job_circumstance": {
          "type": "string",
          "minLength": 3
        },
        "alternatives": {
          "type": "string",
          "minLength": 3
        },
        "unique_attributes": {
          "type": "string",
          "minLength": 3
        },
        "value_proof": {
          "type": "string",
          "minLength": 3
        },
        "best_fit_segment": {
          "type": "string",
          "minLength": 3
        },
        "category_frame": {
          "type": "string",
          "minLength": 3
        },
        "message_boundaries": {
          "type": "string",
          "minLength": 3
        },
        "versioned_context": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
