{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intentional Experience Direction",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "brand_product_intent",
        "mood_anti_mood",
        "hierarchy_rhythm",
        "signature_moments",
        "component_motion_rules",
        "prototype_key_journeys",
        "accessibility_performance",
        "perceptual_review"
      ],
      "properties": {
        "brand_product_intent": {
          "type": "string",
          "minLength": 3
        },
        "mood_anti_mood": {
          "type": "string",
          "minLength": 3
        },
        "hierarchy_rhythm": {
          "type": "string",
          "minLength": 3
        },
        "signature_moments": {
          "type": "string",
          "minLength": 3
        },
        "component_motion_rules": {
          "type": "string",
          "minLength": 3
        },
        "prototype_key_journeys": {
          "type": "string",
          "minLength": 3
        },
        "accessibility_performance": {
          "type": "string",
          "minLength": 3
        },
        "perceptual_review": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
