{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layered Editorial Diagnosis",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "objetivo_audi_ncia",
        "factual_claim_gate",
        "arquitetura",
        "par_grafo",
        "frase",
        "palavra",
        "voz_consist_ncia",
        "acessibilidade",
        "revis_o_priorizada_com_antes_depois"
      ],
      "properties": {
        "objetivo_audi_ncia": {
          "type": "string",
          "minLength": 3
        },
        "factual_claim_gate": {
          "type": "string",
          "minLength": 3
        },
        "arquitetura": {
          "type": "string",
          "minLength": 3
        },
        "par_grafo": {
          "type": "string",
          "minLength": 3
        },
        "frase": {
          "type": "string",
          "minLength": 3
        },
        "palavra": {
          "type": "string",
          "minLength": 3
        },
        "voz_consist_ncia": {
          "type": "string",
          "minLength": 3
        },
        "acessibilidade": {
          "type": "string",
          "minLength": 3
        },
        "revis_o_priorizada_com_antes_depois": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
