{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notation-Semantics Pipeline",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "audi_ncia_pergunta",
        "selecionar_bpmn_uml_c4_flow_er",
        "definir_grammar",
        "modelar_happy_path",
        "exceptions",
        "lint_sem_ntico",
        "render",
        "legenda_e_source"
      ],
      "properties": {
        "audi_ncia_pergunta": {
          "type": "string",
          "minLength": 3
        },
        "selecionar_bpmn_uml_c4_flow_er": {
          "type": "string",
          "minLength": 3
        },
        "definir_grammar": {
          "type": "string",
          "minLength": 3
        },
        "modelar_happy_path": {
          "type": "string",
          "minLength": 3
        },
        "exceptions": {
          "type": "string",
          "minLength": 3
        },
        "lint_sem_ntico": {
          "type": "string",
          "minLength": 3
        },
        "render": {
          "type": "string",
          "minLength": 3
        },
        "legenda_e_source": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
