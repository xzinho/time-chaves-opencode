{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-Stage Forecast",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "define_stage_exit_evidence",
        "clean_opportunities",
        "code_objections",
        "aging_slippage",
        "base_rates_by_cohort",
        "opportunity_adjustments",
        "commit_base_upside",
        "interventions"
      ],
      "properties": {
        "define_stage_exit_evidence": {
          "type": "string",
          "minLength": 3
        },
        "clean_opportunities": {
          "type": "string",
          "minLength": 3
        },
        "code_objections": {
          "type": "string",
          "minLength": 3
        },
        "aging_slippage": {
          "type": "string",
          "minLength": 3
        },
        "base_rates_by_cohort": {
          "type": "string",
          "minLength": 3
        },
        "opportunity_adjustments": {
          "type": "string",
          "minLength": 3
        },
        "commit_base_upside": {
          "type": "string",
          "minLength": 3
        },
        "interventions": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
