{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Questão-Norma-Precedente",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "fatos_foro_data",
        "issues",
        "hierarquia_normativa",
        "vig_ncia_altera_es",
        "jurisprud_ncia_por_holding",
        "correntes_e_distin_es",
        "conclus_o_condicionada",
        "citator_log"
      ],
      "properties": {
        "fatos_foro_data": {
          "type": "string",
          "minLength": 3
        },
        "issues": {
          "type": "string",
          "minLength": 3
        },
        "hierarquia_normativa": {
          "type": "string",
          "minLength": 3
        },
        "vig_ncia_altera_es": {
          "type": "string",
          "minLength": 3
        },
        "jurisprud_ncia_por_holding": {
          "type": "string",
          "minLength": 3
        },
        "correntes_e_distin_es": {
          "type": "string",
          "minLength": 3
        },
        "conclus_o_condicionada": {
          "type": "string",
          "minLength": 3
        },
        "citator_log": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
