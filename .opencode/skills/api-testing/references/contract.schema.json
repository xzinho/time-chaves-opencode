{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract-State-Oracles",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "importar_spec",
        "inventariar_opera_es_auth_estados",
        "validar_schema",
        "partitions_e_boundaries",
        "sequ_ncias_stateful",
        "negative_security",
        "timeout_idempotency_retry",
        "relat_rio_de_evid_ncia"
      ],
      "properties": {
        "importar_spec": {
          "type": "string",
          "minLength": 3
        },
        "inventariar_opera_es_auth_estados": {
          "type": "string",
          "minLength": 3
        },
        "validar_schema": {
          "type": "string",
          "minLength": 3
        },
        "partitions_e_boundaries": {
          "type": "string",
          "minLength": 3
        },
        "sequ_ncias_stateful": {
          "type": "string",
          "minLength": 3
        },
        "negative_security": {
          "type": "string",
          "minLength": 3
        },
        "timeout_idempotency_retry": {
          "type": "string",
          "minLength": 3
        },
        "relat_rio_de_evid_ncia": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
