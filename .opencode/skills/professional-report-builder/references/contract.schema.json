{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-to-Report Architecture",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "mandate_audience",
        "report_questions",
        "evidence_register",
        "outline_numbering",
        "methods",
        "findings",
        "implications",
        "recommendations",
        "limitations",
        "appendices_citations",
        "render_qa"
      ],
      "properties": {
        "mandate_audience": {
          "type": "string",
          "minLength": 3
        },
        "report_questions": {
          "type": "string",
          "minLength": 3
        },
        "evidence_register": {
          "type": "string",
          "minLength": 3
        },
        "outline_numbering": {
          "type": "string",
          "minLength": 3
        },
        "methods": {
          "type": "string",
          "minLength": 3
        },
        "findings": {
          "type": "string",
          "minLength": 3
        },
        "implications": {
          "type": "string",
          "minLength": 3
        },
        "recommendations": {
          "type": "string",
          "minLength": 3
        },
        "limitations": {
          "type": "string",
          "minLength": 3
        },
        "appendices_citations": {
          "type": "string",
          "minLength": 3
        },
        "render_qa": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
