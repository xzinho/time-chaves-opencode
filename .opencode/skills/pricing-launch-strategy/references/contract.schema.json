{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Value-WTP Launch Lab",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "segment_jobs",
        "alternatives_reference_price",
        "value_drivers",
        "wtp_research",
        "package_architecture",
        "unit_economics",
        "price_scenarios",
        "launch_cohort",
        "instrumentation_guardrails"
      ],
      "properties": {
        "segment_jobs": {
          "type": "string",
          "minLength": 3
        },
        "alternatives_reference_price": {
          "type": "string",
          "minLength": 3
        },
        "value_drivers": {
          "type": "string",
          "minLength": 3
        },
        "wtp_research": {
          "type": "string",
          "minLength": 3
        },
        "package_architecture": {
          "type": "string",
          "minLength": 3
        },
        "unit_economics": {
          "type": "string",
          "minLength": 3
        },
        "price_scenarios": {
          "type": "string",
          "minLength": 3
        },
        "launch_cohort": {
          "type": "string",
          "minLength": 3
        },
        "instrumentation_guardrails": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
