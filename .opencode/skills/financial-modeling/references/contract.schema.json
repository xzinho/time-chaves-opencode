{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inputs-Logic-Outputs-Control",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "objective_granularity",
        "timeline",
        "assumptions_register",
        "inputs",
        "calculation_blocks",
        "statements_outputs",
        "sensitivities_scenarios",
        "integrity_checks",
        "review"
      ],
      "properties": {
        "objective_granularity": {
          "type": "string",
          "minLength": 3
        },
        "timeline": {
          "type": "string",
          "minLength": 3
        },
        "assumptions_register": {
          "type": "string",
          "minLength": 3
        },
        "inputs": {
          "type": "string",
          "minLength": 3
        },
        "calculation_blocks": {
          "type": "string",
          "minLength": 3
        },
        "statements_outputs": {
          "type": "string",
          "minLength": 3
        },
        "sensitivities_scenarios": {
          "type": "string",
          "minLength": 3
        },
        "integrity_checks": {
          "type": "string",
          "minLength": 3
        },
        "review": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
