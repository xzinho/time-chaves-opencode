{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argument-to-Slide System",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "audience_decision",
        "storyline",
        "evidence_inventory",
        "slide_functions",
        "wireframes",
        "chart_selection",
        "build",
        "speaker_notes",
        "accessibility",
        "rehearsal_render_qa"
      ],
      "properties": {
        "audience_decision": {
          "type": "string",
          "minLength": 3
        },
        "storyline": {
          "type": "string",
          "minLength": 3
        },
        "evidence_inventory": {
          "type": "string",
          "minLength": 3
        },
        "slide_functions": {
          "type": "string",
          "minLength": 3
        },
        "wireframes": {
          "type": "string",
          "minLength": 3
        },
        "chart_selection": {
          "type": "string",
          "minLength": 3
        },
        "build": {
          "type": "string",
          "minLength": 3
        },
        "speaker_notes": {
          "type": "string",
          "minLength": 3
        },
        "accessibility": {
          "type": "string",
          "minLength": 3
        },
        "rehearsal_render_qa": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
