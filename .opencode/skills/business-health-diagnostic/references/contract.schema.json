{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causal Health Map",
  "type": "object",
  "required": [
    "objective",
    "context",
    "owner",
    "due_date",
    "evidence",
    "steps"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string",
      "minLength": 8
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "outcomes_tend_ncias",
        "value_model",
        "drivers_por_mercado_cliente_opera_o_pessoas_finan_as",
        "symptom_to_cause_tree",
        "evidence_confidence",
        "constraints",
        "30_60_90"
      ],
      "properties": {
        "outcomes_tend_ncias": {
          "type": "string",
          "minLength": 3
        },
        "value_model": {
          "type": "string",
          "minLength": 3
        },
        "drivers_por_mercado_cliente_opera_o_pessoas_finan_as": {
          "type": "string",
          "minLength": 3
        },
        "symptom_to_cause_tree": {
          "type": "string",
          "minLength": 3
        },
        "evidence_confidence": {
          "type": "string",
          "minLength": 3
        },
        "constraints": {
          "type": "string",
          "minLength": 3
        },
        "30_60_90": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
